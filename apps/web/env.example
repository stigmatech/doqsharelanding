# Base URL
NEXT_PUBLIC_BASE_URL=https://doqshare.com

# Cal.com Configuration
NEXT_PUBLIC_CALCOM_NAMESPACE=doqshare
NEXT_PUBLIC_CALCOM_LINK=stigmatech/doqshare

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Database (for future admin section)
DATABASE_URL=postgresql://username:password@localhost:5432/doqshare

# Authentication (for future admin section)
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=https://doqshare.com

# Site Verification
GOOGLE_SITE_VERIFICATION=your-google-verification-code
YANDEX_VERIFICATION=your-yandex-verification-code
YAHOO_VERIFICATION=your-yahoo-verification-code

# Configuration de production
NODE_ENV=production
